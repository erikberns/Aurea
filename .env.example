# Variables del sistema completo (docker compose).
# Copiar este archivo como .env en la raíz del repositorio y completar los valores.
# Si falta una variable obligatoria, docker compose corta el arranque con un mensaje que la nombra.
# Nunca commitear el archivo .env: está en .gitignore.

# --- Base de datos PostgreSQL (obligatorias) ---
# Usuario y contraseña con los que se crea la base "aurea" en el primer arranque.
DB_USERNAME=
DB_PASSWORD=

# --- Broker RabbitMQ (obligatorias) ---
# Usuario y contraseña del broker; también sirven para entrar a la consola en http://localhost:15672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# --- Seguridad (obligatoria) ---
# Clave de firma de los JWT: una cadena aleatoria de al menos 32 caracteres.
JWT_SECRET=

# --- Administrador inicial (ADMIN_PASSWORD es obligatoria) ---
# Se crea en el primer arranque si no existe. Con estos datos se ingresa al panel /admin.
ADMIN_EMAIL=admin@aurea.com
ADMIN_PASSWORD=

# --- Pasarela de pago (opcional) ---
# simulado: pagos de prueba locales, sin red ni claves (valor por defecto).
# stripe: Stripe en modo de prueba; requiere STRIPE_SECRET_KEY de dashboard.stripe.com (modo Test).
PAGOS_PROVEEDOR=simulado
STRIPE_SECRET_KEY=

# --- Asistente de descripciones con IA (opcional) ---
# Sin clave funciona igual con un modelo simulado. Para usar Gemini de verdad, completar IA_API_KEY
# con una clave gratuita de Google AI Studio (aistudio.google.com > Get API key). No hace falta nada más.
IA_API_KEY=
# Opcionales: identificador del modelo tal como figura en AI Studio, y false para apagar el asistente.
IA_MODELO=gemini-3.8-flash
IA_HABILITADA=true
# Cuánto razona el modelo antes de responder: minimal, low (por defecto), medium o high.
IA_NIVEL_RAZONAMIENTO=low
