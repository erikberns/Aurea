# Copiar este archivo como .env en esta misma carpeta.
# Sustituir nombre de base, usuario y contrasena por los de PostgreSQL.
# Sin comillas: Spring importa este archivo como propiedades Java.
DB_URL=jdbc:postgresql://localhost:5432/NOMBRE_DE_LA_BASE
DB_USERNAME=USUARIO_POSTGRES
DB_PASSWORD=CONTRASENA_POSTGRES
DDL_AUTO=validate
CORS_ALLOWED_ORIGIN=http://localhost:5173

# validate comprueba el esquema existente sin modificarlo.
# Para crear/actualizar las tablas del entorno de desarrollo, usar DDL_AUTO=update.
