# Copiar este archivo como .env en esta misma carpeta.
# Sustituir nombre de base, usuario y contrasena por los de PostgreSQL.
# Sin comillas: Spring importa este archivo como propiedades Java.
DB_URL=jdbc:postgresql://localhost:5432/NOMBRE_DE_LA_BASE
DB_USERNAME=USUARIO_POSTGRES
DB_PASSWORD=CONTRASENA_POSTGRES
DDL_AUTO=validate
CORS_ALLOWED_ORIGIN=http://localhost:5173
# Clave de firma de los JWT: obligatoria, de al menos 32 caracteres. Sin ella el backend no arranca.
JWT_SECRET=COMPLETAR
# Administrador inicial: se crea en el primer arranque si ADMIN_PASSWORD tiene valor.
ADMIN_EMAIL=admin@aurea.com
ADMIN_PASSWORD=COMPLETAR
PROVEEDOR_SOAP_URL=http://127.0.0.1:8091/soap/proveedor
PROVEEDOR_TIMEOUT_MS=5000
REPOSICIONES_MESSAGING_ENABLED=true
ORDER_PROCESSING_MESSAGING_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# Usuario y contraseña de RabbitMQ (los usa también docker-compose.yml de esta carpeta).
RABBITMQ_USERNAME=COMPLETAR
RABBITMQ_PASSWORD=COMPLETAR

# validate comprueba el esquema existente sin modificarlo.
# Para crear/actualizar las tablas del entorno de desarrollo, usar DDL_AUTO=update.

# Pasarela de pago. simulado = local, sin red. stripe = Stripe en modo de prueba.
# La clave se obtiene en dashboard.stripe.com > Developers > API keys (modo Test). Nunca subirla al repositorio.
PAGOS_PROVEEDOR=simulado
STRIPE_SECRET_KEY=sk_test_COMPLETAR
PAGOS_MONEDA=ars
PAGOS_TIMEOUT_MS=5000
